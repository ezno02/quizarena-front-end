PORT=4002

# Fuso usado para definir a rodada do dia (chave YYYY-MM-DD).
APP_TIMEZONE=America/Sao_Paulo

# --- Firebase Admin SDK (obrigatório) ---------------------------------------
# Precisa ser uma SERVICE ACCOUNT, não as credenciais do Firebase Web.
# Uma API key (começa com AIza) NÃO funciona aqui: ela autentica o navegador,
# não o servidor.
#
# Firebase console > Project settings > Service accounts > Generate new private key
# Baixe o .json e copie os três campos abaixo. A service account também precisa
# do papel "Cloud Datastore User" no projeto.
#
# Valide a configuração com: npm run check:firebase
FIREBASE_PROJECT_ID=seu-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# --- Script Diário ----------------------------------------------------------
# Protege POST /api/daily/run e assina a sessão do player.
# Sem CRON_SECRET a rota responde 503 e as sessões expiram a cada reinício.
CRON_SECRET=troque-por-um-segredo-longo

# Segredo separado para assinar o token de sessão (opcional; usa CRON_SECRET).
PLAYER_TOKEN_SECRET=troque-por-outro-segredo-longo

# --- Regras do jogo ---------------------------------------------------------
# Quantas questões por rodada (o fluxograma fixa 7).
DAILY_QUESTION_COUNT=7
# Pontuação base antes do peso dinâmico por raridade.
BASE_POINTS_PER_QUESTION=100
# Não repetir uma questão dentro desta janela (dias).
QUESTION_COOLDOWN_DAYS=30
# Quantos players aparecem no ranking lateral.
RANKING_LIMIT=10
